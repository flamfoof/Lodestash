# Rust build output
/target/
**/target/

# AI model files (downloaded per AI-MODELS-BY-GPU.md, not committed)
/models/
*.onnx
*.onnx_data
*.gguf
*.safetensors
*.bin

# Lodestash runtime data / catalog / caches
/cache/
/.lodestash/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp

# Local agent-tooling state (claude-flow / ruflo daemons, metrics, generated configs)
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version

# Claudenator isolate worktrees (ephemeral, agent-owned)
.claudenator-wt-*/

# Node deps: the UI has its own rule, but tooling run from the repo root (reasonix, MCP
# helpers) installs here too — without a root rule a single `git add .` stages tens of
# thousands of dependency files onto main.
node_modules/

# Node deps: the UI has its own rule, but tooling run from the repo root (reasonix, MCP
# helpers) installs here too — without a root rule a single `git add .` stages tens of
# thousands of dependency files onto main.
node_modules/

# Root lockfile: the root package.json is a task runner with no dependencies, so a stray
# `bun install` here would write a second lockfile next to the real one in
# crates/lodestash-desktop/ui/bun.lock (TECH-STACK §5 says there is exactly one).
/bun.lock
