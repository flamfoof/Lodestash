{
  "name": "lodestash",
  "private": true,
  "description": "Root task runner — the app and its gates, runnable from the repo root. Frontend deps live in crates/lodestash-desktop/ui.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:release": "node scripts/dev.mjs --release",
    "setup": "bun install --cwd crates/lodestash-desktop/ui",
    "build": "bun run --cwd crates/lodestash-desktop/ui build",
    "check": "bun run --cwd crates/lodestash-desktop/ui check",
    "e2e": "bun run --cwd crates/lodestash-desktop/ui e2e",
    "check-docs": "node scripts/check-docs.mjs",
    "check-board": "node scripts/check-board.mjs"
  }
}
